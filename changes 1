<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>K.I.A Home Service | Crystal Clear. Impeccably Clean.</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Premium window washing, pressure washing, and car detailing in Phoenix, Arizona." />
  <link rel="stylesheet" href="styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script defer src="script.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="brand">
      <!-- Replace src with your actual logo path in the repo -->
      <img src="assets/kia-logo.png" alt="K.I.A Home Service logo" class="brand-logo" />
      <div class="brand-text">
        <span class="brand-name">K.I.A Home Service</span>
        <span class="brand-tagline">Premium Home & Vehicle Care</span>
      </div>
    </div>
    <nav class="nav" id="nav">
      <a href="#hero">Home</a>
      <a href="#services">Services</a>
      <a href="#gallery">Gallery</a>
      <a href="#refer">Refer &amp; Save</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">☰</button>
  </header>

  <main>
    <!-- HERO -->
    <section id="hero" class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Phoenix • Arizona</p>
        <h1>Crystal Clear. Impeccably Clean.</h1>
        <p class="hero-sub">
          Premium Window Washing • Pressure Washing • Luxury Car Detailing
        </p>
        <div class="hero-actions">
          <a href="#quote" class="btn primary">Get Your Free Quote</a>
          <a href="#services" class="btn ghost">View Services</a>
        </div>
        <div class="hero-contact">
          <span>(480) 482-9507</span>
          <span>homeservicekia@gmail.com</span>
        </div>
      </div>
      <div class="hero-panel">
        <div class="hero-card">
          <h2>Why K.I.A?</h2>
          <ul>
            <li>Luxury-level attention to detail</li>
            <li>Crystal-clear windows &amp; spotless finishes</li>
            <li>Fully licensed &amp; insured</li>
            <li>Free inspections &amp; quotes</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section services">
      <header class="section-header">
        <h2>Our Premium Services</h2>
        <p>All first-time inspections and quotes are completely free.</p>
      </header>

      <div class="service-tabs">
        <button class="service-tab active" data-target="windows">Window Washing</button>
        <button class="service-tab" data-target="pressure">Pressure Washing</button>
        <button class="service-tab" data-target="detailing">Car Detailing</button>
        <button class="service-tab" data-target="bundles">Service Bundles</button>
      </div>

      <div class="service-panels">
        <div class="service-panel active" id="windows">
          <div class="service-grid">
            <article class="card">
              <h3>Exterior Window Washing</h3>
              <p class="muted">Streak-free, crystal-clear exterior glass.</p>
              <ul>
                <li><strong>Small windows:</strong> $5 each</li>
                <li><strong>Large windows:</strong> $10 each</li>
                <li>Professional-grade equipment</li>
                <li>Spotless frames &amp; edges</li>
              </ul>
              <button class="btn primary scroll-quote">Get Quote</button>
            </article>
            <article class="card">
              <h3>Interior Window Washing</h3>
              <p class="muted"><em>Interior pricing discussed during free inspection.</em></p>
              <ul>
                <li>Meticulous interior glass cleaning</li>
                <li>Frame &amp; sill treatment</li>
                <li>Screen cleaning available</li>
                <li>Professional squeegee work</li>
              </ul>
              <button class="btn ghost scroll-quote">Schedule Inspection</button>
            </article>
          </div>
        </div>

        <div class="service-panel" id="pressure">
          <div class="service-grid">
            <article class="card">
              <h3>Driveways &amp; Concrete</h3>
              <p class="muted">Brighten and restore your hard surfaces.</p>
              <ul>
                <li><strong>$0.20 per square foot</strong></li>
                <li>Oil &amp; stain reduction</li>
                <li>Professional pressure equipment</li>
                <li>Perfect for curb appeal</li>
              </ul>
              <button class="btn primary scroll-quote">Get Pressure Wash Quote</button>
            </article>
          </div>
        </div>

        <div class="service-panel" id="detailing">
          <div class="service-grid">
            <article class="card">
              <h3>Bronze Package — Express Clean</h3>
              <p class="tag">Best for weekly maintenance</p>
              <ul>
                <li>Exterior hand wash</li>
                <li>Wheel &amp; tire cleaning</li>
                <li>Interior vacuum</li>
                <li>Window wipe-down</li>
